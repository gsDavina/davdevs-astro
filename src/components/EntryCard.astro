---
import { formatDate, readTimeShort, type ListingType } from '../lib/content';
import type { CollectionEntry } from 'astro:content';

/**
 * The card used on both the home page's per-type sections and the listing
 * pages — davdevs-laravel uses the exact same markup in both places
 * (site/home.blade.php and site/listing.blade.php), just inside grids of
 * different sizes. Deliberately plain: title, 2-line excerpt, one meta
 * line. No tags, no like count — the source cards don't show either.
 */
interface Props {
  type: Exclude<ListingType, 'sermon' | 'template'>;
  entry: CollectionEntry<Exclude<ListingType, 'sermon' | 'template'>>;
}
const { type, entry } = Astro.props;
const href = `/${type}/${entry.data.slug}`;
---

<a class="entry-card" href={href}>
  <div class="entry-card-title">{entry.data.title}</div>
  {entry.data.excerpt && <div class="entry-card-excerpt">{entry.data.excerpt}</div>}
  <div class="entry-card-meta">
    {formatDate(entry.data.datePublished)} · {readTimeShort(entry.data.readTimeMinutes, entry.body)}
  </div>
</a>

<style>
  .entry-card {
    background: var(--bg-page);
    padding: 16px 18px;
    display: block;
    transition: background var(--duration-base) var(--easing-default);
  }
  .entry-card:hover {
    background: var(--bg-surface-1);
  }
  .entry-card-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 14px;
    color: var(--text-primary);
    margin-bottom: 6px;
  }
  .entry-card-excerpt {
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--text-secondary);
    margin-bottom: 8px;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .entry-card-meta {
    font-family: var(--font-mono);
    font-size: 8px;
    color: var(--text-faint);
  }
</style>
