<div class="search-overlay" data-search-overlay hidden>
  <div class="search-box">
    <input
      type="text"
      class="search-input"
      data-search-input
      placeholder="Search articles, projects, tools…"
      autocomplete="off"
    />
    <div class="search-results" data-search-results></div>
    <div class="search-hint">
      <span>↑↓ navigate</span>
      <span>↵ open</span>
      <span>esc close</span>
    </div>
  </div>
</div>

<style>
  .search-overlay {
    position: fixed;
    inset: 0;
    background: var(--search-overlay);
    backdrop-filter: blur(4px);
    z-index: 200;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 100px;
  }
  .search-overlay[hidden] {
    display: none;
  }
  .search-box {
    background: var(--search-bg);
    border-radius: var(--radius-modal);
    width: 100%;
    max-width: 560px;
    box-shadow: var(--shadow-search);
    margin: 0 16px;
  }
  .search-input {
    width: 100%;
    box-sizing: border-box;
    background: transparent;
    border: none;
    border-bottom: 0.5px solid var(--search-border);
    padding: 16px 20px;
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--text-primary);
    outline: none;
  }
  /* Focus-visible indicator: the input is auto-focused when this modal
     opens, so its own `outline: none` above needs a replacement — a
     bottom-border color change fits the borderless input better than a
     full outline box. */
  .search-input:focus-visible {
    border-bottom-color: var(--accent);
  }
  .search-results {
    max-height: 400px;
    overflow-y: auto;
    padding: 8px;
  }
  /* .search-result* and mark are injected at runtime via innerHTML (see
     script below), so they never receive Astro's scoped data-astro-cid
     attribute — these rules must be :global() to actually apply. */
  :global(.search-result) {
    display: block;
    padding: 10px 12px;
    border-radius: 6px;
  }
  :global(.search-result.active) {
    background: var(--bg-surface-2);
  }
  :global(.search-result-title) {
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--text-primary);
  }
  :global(.search-result-title mark) {
    background: none;
    color: var(--search-match);
  }
  :global(.search-result-type) {
    font-family: var(--font-mono);
    font-size: 9px;
    color: var(--text-muted);
    margin-top: 2px;
  }
  :global(.search-empty) {
    padding: 20px 12px;
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--text-muted);
    text-align: center;
  }
  .search-hint {
    display: flex;
    gap: 14px;
    padding: 8px 16px;
    border-top: 0.5px solid var(--search-border);
    font-family: var(--font-mono);
    font-size: 8px;
    color: var(--text-faint);
    letter-spacing: var(--tracking-mono-xs);
  }
</style>

<script is:inline>
  (function () {
    var overlay = document.querySelector('[data-search-overlay]');
    var input = document.querySelector('[data-search-input]');
    var results = document.querySelector('[data-search-results]');
    if (!overlay || !input || !results) return;

    var index = null;
    var activeIndex = -1;
    var currentMatches = [];

    function escapeHtml(s) {
      return s.replace(/[&<>]/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c];
      });
    }

    function highlight(title, query) {
      var i = title.toLowerCase().indexOf(query.toLowerCase());
      if (i === -1) return escapeHtml(title);
      return (
        escapeHtml(title.slice(0, i)) +
        '<mark>' + escapeHtml(title.slice(i, i + query.length)) + '</mark>' +
        escapeHtml(title.slice(i + query.length))
      );
    }

    function render(query) {
      if (!query) {
        results.innerHTML = '';
        currentMatches = [];
        activeIndex = -1;
        return;
      }
      currentMatches = (index || [])
        .filter(function (item) {
          return item.title.toLowerCase().includes(query.toLowerCase());
        })
        .slice(0, 20);
      activeIndex = currentMatches.length ? 0 : -1;
      if (!currentMatches.length) {
        results.innerHTML = '<div class="search-empty">No results</div>';
        return;
      }
      results.innerHTML = currentMatches
        .map(function (item, i) {
          return (
            '<a class="search-result' + (i === 0 ? ' active' : '') + '" href="' + item.url + '" data-index="' + i + '">' +
            '<div class="search-result-title">' + highlight(item.title, query) + '</div>' +
            '<div class="search-result-type">' + escapeHtml(item.type) + '</div>' +
            '</a>'
          );
        })
        .join('');
    }

    function setActive(i) {
      var items = results.querySelectorAll('.search-result');
      items.forEach(function (el) {
        el.classList.remove('active');
      });
      if (items[i]) {
        items[i].classList.add('active');
        items[i].scrollIntoView({ block: 'nearest' });
      }
      activeIndex = i;
    }

    function open() {
      overlay.hidden = false;
      input.value = '';
      results.innerHTML = '';
      input.focus();
      if (!index) {
        fetch('/search-index.json')
          .then(function (r) { return r.json(); })
          .then(function (data) { index = data; });
      }
    }

    function close() {
      overlay.hidden = true;
    }

    window.addEventListener('site-search:open', open);

    document.addEventListener('keydown', function (e) {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        open();
      } else if (e.key === 'Escape' && !overlay.hidden) {
        close();
      } else if (!overlay.hidden && e.key === 'ArrowDown') {
        e.preventDefault();
        if (currentMatches.length) setActive(Math.min(activeIndex + 1, currentMatches.length - 1));
      } else if (!overlay.hidden && e.key === 'ArrowUp') {
        e.preventDefault();
        if (currentMatches.length) setActive(Math.max(activeIndex - 1, 0));
      } else if (!overlay.hidden && e.key === 'Enter') {
        var active = results.querySelector('.search-result.active');
        if (active) window.location.href = active.getAttribute('href');
      }
    });

    overlay.addEventListener('click', function (e) {
      if (e.target === overlay) close();
    });

    input.addEventListener('input', function () {
      render(input.value.trim());
    });
  })();
</script>
