---
/**
 * Anonymous like button. davdevs-laravel backs this with a signed HttpOnly
 * cookie + hashed-IP rate limiting + a DB-stored count shared across every
 * visitor (see 01-milestones.md Phase 8 / entry-detail.blade.php's plain
 * "♥ {count}" button). This static Astro build has no server, so the
 * toggle + count here are per-browser only (localStorage) — not shared
 * across visitors or devices. Wiring a real shared counter needs a backend
 * (Cloudflare KV/D1, Supabase, etc.), which is a hosting decision not yet
 * made for this rebuild; see 03-progress.md.
 */
interface Props {
  contentKey: string;
}
const { contentKey } = Astro.props;
---

<div class="like-row" data-like-btn data-like-key={contentKey}>
  <button class="like-heart" type="button" aria-label="Like this post">♥</button>
  <span class="like-count" data-like-count>0</span>
</div>

<style>
  .like-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .like-heart {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    font-size: 16px;
    line-height: 1;
    color: var(--like-icon);
    transition: color var(--duration-fast);
  }
  .like-row.liked .like-heart {
    color: var(--like-icon-liked);
  }
  .like-count {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--like-count);
  }
</style>

<script is:inline>
  (function () {
    document.querySelectorAll('[data-like-btn]').forEach(function (row) {
      var key = 'like:' + row.getAttribute('data-like-key');
      var countEl = row.querySelector('[data-like-count]');
      function read() {
        try {
          return JSON.parse(localStorage.getItem(key) || '{"liked":false,"count":0}');
        } catch (e) {
          return { liked: false, count: 0 };
        }
      }
      function render(state) {
        countEl.textContent = String(state.count);
        row.classList.toggle('liked', state.liked);
      }
      render(read());
      row.querySelector('.like-heart').addEventListener('click', function () {
        var state = read();
        state.liked = !state.liked;
        state.count = Math.max(0, state.count + (state.liked ? 1 : -1));
        try {
          localStorage.setItem(key, JSON.stringify(state));
        } catch (e) {}
        render(state);
      });
    });
  })();
</script>
