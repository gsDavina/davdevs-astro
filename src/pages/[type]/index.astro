---
import Site from '../../layouts/Site.astro';
import EntryCard from '../../components/EntryCard.astro';
import {
  BLOG_TYPES,
  EMPTY_TYPES,
  LISTING_TYPES,
  TYPE_LABELS,
  getBlogEntries,
  type BlogType,
} from '../../lib/content';

export async function getStaticPaths() {
  return LISTING_TYPES.map((type) => ({ params: { type } }));
}

const { type } = Astro.params as { type: (typeof LISTING_TYPES)[number] };
const isEmptyType = (EMPTY_TYPES as readonly string[]).includes(type);
const entries = isEmptyType ? [] : await getBlogEntries(type as BlogType);
const label = TYPE_LABELS[type];
---

<Site title={label} description={`${label} by Davina Leong.`}>
  <section class="listing">
    <h1 class="listing-title">{label}</h1>

    <div class="entry-grid">
      {entries.length === 0 ? (
        <p class="empty">No entries found.</p>
      ) : (
        entries.map((entry) => <EntryCard type={type as BlogType} entry={entry} />)
      )}
    </div>
  </section>
</Site>

<style>
  .listing {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 48px var(--page-padding-x);
  }
  .listing-title {
    font-family: var(--font-display);
    font-size: clamp(24px, 4vw, 32px);
    font-weight: 800;
    color: var(--text-primary);
    margin: 0 0 24px;
  }
  .entry-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1px;
    background: var(--border-default);
  }
  .empty {
    grid-column: 1 / -1;
    color: var(--text-muted);
    font-family: var(--font-sans);
    font-size: 13px;
    padding: 40px;
    text-align: center;
    background: var(--bg-page);
  }

  @media (max-width: 767px) {
    .listing {
      padding: 28px var(--page-padding-x-sm);
    }
  }
</style>
