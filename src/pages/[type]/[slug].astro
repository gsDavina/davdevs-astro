---
import { render } from 'astro:content';
import Site from '../../layouts/Site.astro';
import Tag from '../../components/Tag.astro';
import LikeButton from '../../components/LikeButton.astro';
import ShareRow from '../../components/ShareRow.astro';
import ToolMount from '../../components/tools/ToolMount';
import { blogEntryJsonLd } from '../../lib/jsonld';
import {
  BLOG_TYPES,
  TYPE_LABELS,
  formatDate,
  readTimeLabel,
  getBlogEntries,
} from '../../lib/content';

export async function getStaticPaths() {
  const paths = [];
  for (const type of BLOG_TYPES) {
    const entries = await getBlogEntries(type);
    for (const entry of entries) {
      paths.push({ params: { type, slug: entry.data.slug }, props: { entry } });
    }
  }
  return paths;
}

const { type } = Astro.params as { type: (typeof BLOG_TYPES)[number] };
const { entry } = Astro.props as { entry: Awaited<ReturnType<typeof getBlogEntries>>[number] };
const { Content } = await render(entry);
const label = TYPE_LABELS[type];
const href = `/${type}/${entry.data.slug}`;
const toolComponentName = type === 'tool' ? entry.data.reactComponent : undefined;
const canonicalURL = new URL(href, Astro.site).toString();
const jsonLd = blogEntryJsonLd(type, entry, canonicalURL);
---

<Site
  title={entry.data.title}
  description={entry.data.excerpt}
  ogImage={entry.data.images?.[0]?.src}
  jsonLd={jsonLd}
  showProgress
>
  <article class="entry">
    <div class="kicker">
      {label} · {formatDate(entry.data.datePublished)} · {readTimeLabel(entry.data.readTimeMinutes, entry.body)}
    </div>
    <h1 class="entry-title">{entry.data.title}</h1>

    {entry.data.tags.length > 0 && (
      <div class="entry-tags">
        {entry.data.tags.map((tag) => <Tag tag={tag} />)}
      </div>
    )}

    {toolComponentName && (
      <div class="tool-embed">
        <ToolMount component={toolComponentName} client:load />
      </div>
    )}

    <div class="prose" data-prose>
      <Content />
    </div>

    {entry.data.images && entry.data.images.length > 0 && (
      <div class="entry-images">
        {entry.data.images.map((image) => (
          <figure>
            <img src={image.src} alt={image.alt} loading="lazy" />
            {image.caption && <figcaption>{image.caption}</figcaption>}
          </figure>
        ))}
      </div>
    )}

    <LikeButton contentKey={href} />

    <div class="share-wrap">
      <ShareRow title={entry.data.title} />
    </div>
  </article>
</Site>

<style>
  .entry {
    max-width: var(--prose-max);
    margin: 0 auto;
    padding: 48px var(--page-padding-x);
  }
  .kicker {
    font-family: var(--font-mono);
    font-size: 9px;
    color: var(--text-faint);
    margin-bottom: 12px;
  }
  .entry-title {
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 800;
    color: var(--text-primary);
    margin: 0 0 20px;
    line-height: 1.2;
  }
  .entry-tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }

  .tool-embed {
    margin-bottom: 32px;
  }

  .prose {
    font-family: var(--font-prose);
    font-size: 14px;
    line-height: 1.8;
    color: var(--text-body);
  }
  .prose :global(p) {
    margin-bottom: 1.4em;
  }
  .prose :global(h2) {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 18px;
    color: var(--text-primary);
    margin: 2em 0 0.6em;
  }
  .prose :global(h3) {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 15px;
    color: var(--text-primary);
    margin: 1.6em 0 0.5em;
  }
  .prose :global(a) {
    color: var(--accent);
  }
  .prose :global(strong) {
    font-weight: 600;
    color: var(--text-primary);
  }
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 12px;
    background: var(--bg-surface-2);
    color: var(--accent);
    padding: 1px 5px;
    border-radius: 3px;
  }
  .prose :global(pre) {
    background: var(--bg-surface-2);
    border: 0.5px solid var(--border-default);
    border-radius: var(--radius-code);
    padding: 16px 18px;
    margin: 1.4em 0;
    overflow-x: auto;
  }
  .prose :global(pre code) {
    background: none;
    color: var(--text-body);
    font-size: 12px;
    padding: 0;
  }
  .prose :global(blockquote) {
    border-left: 2px solid var(--accent);
    padding-left: 16px;
    margin: 1.4em 0;
    font-style: italic;
    color: var(--text-secondary);
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 20px;
    margin-bottom: 1.4em;
  }
  .prose :global(li) {
    margin-bottom: 0.4em;
  }

  .entry-images {
    margin-top: 32px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .entry-images figure {
    margin: 0;
  }
  .entry-images img {
    width: 100%;
    border-radius: 8px;
  }
  .entry-images figcaption {
    font-family: var(--font-sans);
    font-size: 11px;
    color: var(--text-muted);
    margin-top: 6px;
  }

  .entry :global(.like-row) {
    margin-top: 32px;
  }
  .share-wrap {
    margin-top: 16px;
  }
</style>
