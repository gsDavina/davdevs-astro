---
import Site from '../layouts/Site.astro';
---

<Site title="Page Not Found">
  <section class="not-found">
    <p class="code">404</p>
    <h1>Page not found</h1>
    <p class="sub">The page you're looking for doesn't exist or has moved.</p>
    <a class="home-link" href="/">← back to home</a>
  </section>
</Site>

<style>
  .not-found {
    max-width: 480px;
    margin: 0 auto;
    padding: 120px 36px;
    text-align: center;
  }
  .code {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent);
    letter-spacing: var(--tracking-mono-sm);
    margin: 0 0 8px;
  }
  h1 {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 800;
    color: var(--text-primary);
    margin: 0 0 12px;
  }
  .sub {
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--text-secondary);
    margin: 0 0 24px;
  }
  .home-link {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--accent);
    letter-spacing: var(--tracking-mono-sm);
  }
</style>
