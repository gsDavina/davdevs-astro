---
import Site from '../../layouts/Site.astro';
import { getCollection } from 'astro:content';
import { formatPriceCents } from '../../lib/format';

const allEbooks = await getCollection('ebook');
const bundles = allEbooks.filter((e) => e.data.isBundle);
const individual = allEbooks.filter((e) => !e.data.isBundle);
---

<Site title="E-Books" description="E-books by Davina Leong.">
  <section class="ebooks">
    <h1 class="ebooks-title">E-Books</h1>

    {bundles.length > 0 && (
      <>
        <h2 class="ebooks-subhead">Bundles</h2>
        <div class="entry-grid bundles-grid">
          {bundles.map((entry) => (
            <a class="entry-card" href={`/ebooks/${entry.data.slug}`}>
              {entry.data.coverImage && <img src={entry.data.coverImage} alt={entry.data.title} loading="lazy" />}
              <div class="entry-card-title">{entry.data.title}</div>
              <div class="entry-card-tagline">{entry.data.tagline}</div>
              {entry.data.pricingTiers[0] && (
                <div class="entry-card-price">
                  {formatPriceCents(entry.data.pricingTiers[0].priceCents, entry.data.pricingTiers[0].currency)}
                </div>
              )}
            </a>
          ))}
        </div>
      </>
    )}

    <h2 class="ebooks-subhead">E-Books</h2>
    <div class="entry-grid">
      {individual.length === 0 ? (
        <p class="empty">No e-books yet.</p>
      ) : (
        individual.map((entry) => (
          <a class="entry-card" href={`/ebooks/${entry.data.slug}`}>
            {entry.data.coverImage && <img src={entry.data.coverImage} alt={entry.data.title} loading="lazy" />}
            <div class="entry-card-title">{entry.data.title}</div>
            <div class="entry-card-tagline">{entry.data.tagline}</div>
            {entry.data.pricingTiers[0] && (
              <div class="entry-card-price">
                {formatPriceCents(entry.data.pricingTiers[0].priceCents, entry.data.pricingTiers[0].currency)}
              </div>
            )}
          </a>
        ))
      )}
    </div>
  </section>
</Site>

<style>
  .ebooks {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 48px var(--page-padding-x);
  }
  .ebooks-title {
    font-family: var(--font-display);
    font-size: clamp(24px, 4vw, 32px);
    font-weight: 800;
    color: var(--text-primary);
    margin: 0 0 24px;
  }
  .ebooks-subhead {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 12px;
  }
  .entry-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1px;
    background: var(--border-default);
  }
  .bundles-grid {
    margin-bottom: 36px;
  }
  .entry-card {
    background: var(--bg-page);
    padding: 18px;
    display: block;
  }
  .entry-card img {
    width: 100%;
    border-radius: 6px;
    margin-bottom: 10px;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }
  .entry-card-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 14px;
    color: var(--text-primary);
    margin-bottom: 4px;
  }
  .entry-card-tagline {
    font-family: var(--font-sans);
    font-size: 11px;
    color: var(--text-secondary);
  }
  .entry-card-price {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--accent);
    margin-top: 6px;
  }
  .empty {
    grid-column: 1 / -1;
    color: var(--text-muted);
    font-family: var(--font-sans);
    font-size: 13px;
    padding: 40px;
    text-align: center;
    background: var(--bg-page);
  }

  @media (max-width: 767px) {
    .ebooks {
      padding: 28px var(--page-padding-x-sm);
    }
  }
</style>
