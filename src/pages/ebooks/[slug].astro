---
import { render } from 'astro:content';
import { getCollection } from 'astro:content';
import Site from '../../layouts/Site.astro';
import { ebookJsonLd } from '../../lib/jsonld';

export async function getStaticPaths() {
  const ebooks = await getCollection('ebook');
  return ebooks.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props as { entry: Awaited<ReturnType<typeof getCollection<'ebook'>>>[number] };
const { Content } = await render(entry);
const href = `/ebooks/${entry.data.slug}`;
const canonicalURL = new URL(href, Astro.site).toString();
const jsonLd = ebookJsonLd(entry, canonicalURL);
---

<Site title={entry.data.title} description={entry.data.tagline} ogImage={entry.data.coverImage ?? undefined} jsonLd={jsonLd}>
  <article class="ebook">
    {entry.data.coverImage && <img class="ebook-cover" src={entry.data.coverImage} alt={entry.data.title} />}
    <h1 class="ebook-title">{entry.data.title}</h1>
    {entry.data.tagline && <p class="ebook-tagline">{entry.data.tagline}</p>}

    <div class="prose">
      <Content />
    </div>

    {entry.data.pricingTiers.length > 0 && (
      <div class="ebook-cta-row">
        {entry.data.pricingTiers.map((tier) => tier.checkoutUrl && (
          <a class="btn-get" href={tier.checkoutUrl} target="_blank" rel="noopener noreferrer">
            Get it — {tier.name} {tier.price} →
          </a>
        ))}
      </div>
    )}
  </article>
</Site>

<style>
  .ebook {
    max-width: var(--prose-max);
    margin: 0 auto;
    padding: 48px var(--page-padding-x);
  }
  .ebook-cover {
    width: 100%;
    border-radius: 10px;
    margin-bottom: 24px;
  }
  .ebook-title {
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 800;
    color: var(--text-primary);
    margin: 0 0 8px;
  }
  .ebook-tagline {
    font-family: var(--font-sans);
    font-size: 15px;
    color: var(--text-secondary);
    margin: 0 0 24px;
  }
  .prose {
    font-family: var(--font-prose);
    font-size: 14px;
    line-height: 1.8;
    color: var(--text-body);
    margin-bottom: 32px;
  }
  .prose :global(h2) {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 18px;
    color: var(--text-primary);
    margin: 2em 0 0.6em;
  }
  .prose :global(h3) {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 15px;
    color: var(--text-primary);
    margin: 1.6em 0 0.5em;
  }
  .prose :global(a) {
    color: var(--accent);
  }
  .prose :global(strong) {
    font-weight: 600;
    color: var(--text-primary);
  }
  .ebook-cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .btn-get {
    display: inline-block;
    background: var(--accent);
    color: var(--bg-page);
    padding: 12px 24px;
    border-radius: 5px;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
  }
</style>
