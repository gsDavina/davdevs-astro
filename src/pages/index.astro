---
import Site from '../layouts/Site.astro';
import EntryCard from '../components/EntryCard.astro';
import { HOME_SECTION_ORDER, TYPE_LABELS, getBlogEntries } from '../lib/content';
import { getCollection } from 'astro:content';

const sections = await Promise.all(
  HOME_SECTION_ORDER.map(async (type) => ({
    type,
    label: TYPE_LABELS[type],
    entries: await getBlogEntries(type),
  }))
);

const ebooks = await getCollection('ebook');
---

<Site
  title="Home"
  description="Davina Develops — projects, articles, tools, and everything in between."
>
  <section class="hero">
    <h1 class="hero-wordmark">
      ~/dav/<span class="accent">devs</span> <span class="cursor">_</span>
    </h1>
    <p class="hero-sub">Davina Develops — projects, articles, tools, and everything in between.</p>
  </section>

  {ebooks.length > 0 && (
    <section class="home-section">
      <div class="home-section-head">
        <h2>E-Books</h2>
        <a class="view-all" href="/ebooks">view all →</a>
      </div>
      <div class="entry-grid">
        {ebooks.map((entry) => (
          <a class="entry-card" href={`/ebooks/${entry.data.slug}`}>
            {entry.data.coverImage && <img class="entry-card-cover" src={entry.data.coverImage} alt={entry.data.title} loading="lazy" />}
            <div class="entry-card-title">{entry.data.title}</div>
            {entry.data.tagline && <div class="entry-card-tagline">{entry.data.tagline}</div>}
            {entry.data.pricingTiers[0] && <div class="entry-card-price">{entry.data.pricingTiers[0].price}</div>}
          </a>
        ))}
      </div>
    </section>
  )}

  {sections.map((section) => section.entries.length > 0 && (
    <section class="home-section">
      <div class="home-section-head">
        <h2>{section.label}</h2>
        <a class="view-all" href={`/${section.type}`}>view all →</a>
      </div>
      <div class="entry-grid">
        {section.entries.map((entry) => <EntryCard type={section.type} entry={entry} />)}
      </div>
    </section>
  ))}
</Site>

<style>
  .hero {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 80px var(--page-padding-x) 60px;
    text-align: center;
  }
  .hero-wordmark {
    font-family: var(--font-display);
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 800;
    letter-spacing: var(--tracking-display);
    color: var(--text-primary);
    margin: 0;
  }
  .hero-wordmark .accent {
    color: var(--accent);
  }
  .hero-wordmark .cursor {
    animation: cursor-blink 1.1s step-end infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-wordmark .cursor {
      animation: none;
    }
  }
  .hero-sub {
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--text-secondary);
    margin-top: 16px;
    max-width: 520px;
    margin-left: auto;
    margin-right: auto;
  }

  .home-section {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 32px var(--page-padding-x);
  }
  .home-section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
  }
  .home-section-head h2 {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
  }
  .view-all {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--accent);
  }
  .entry-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1px;
    background: var(--border-default);
  }

  /* eBook card (bespoke — cover image + tagline + price, not EntryCard's shape) */
  .entry-card {
    background: var(--bg-page);
    padding: 18px;
    display: block;
  }
  .entry-card-cover {
    width: 100%;
    border-radius: 6px;
    margin-bottom: 10px;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }
  .entry-card-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 14px;
    color: var(--text-primary);
    margin-bottom: 4px;
  }
  .entry-card-tagline {
    font-family: var(--font-sans);
    font-size: 11px;
    color: var(--text-secondary);
  }
  .entry-card-price {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--accent);
    margin-top: 6px;
  }

  @media (max-width: 767px) {
    .hero {
      padding: 48px var(--page-padding-x-sm) 36px;
    }
    .home-section {
      padding: 24px var(--page-padding-x-sm);
    }
  }
</style>
