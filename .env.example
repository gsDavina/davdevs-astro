# Postgres — transactional data only (orders). Editorial content (articles,
# projects, ebook pages, etc.) is plain Markdown in src/content/, not a
# database. Must point at a real Postgres server (port 5432 by default) —
# a Railway Postgres instance, or any other hosted/local Postgres.
DATABASE_URL=

# Stripe — test-mode keys while developing (Dashboard → Developers → API keys)
STRIPE_SECRET_KEY=
# For local webhook testing, run `stripe listen --forward-to localhost:4321/api/webhooks/stripe`
# and use the signing secret it prints. In production this comes from a
# webhook endpoint registered in the Stripe Dashboard.
STRIPE_WEBHOOK_SECRET=

# Email (Resend) — sends the post-purchase ebook download-link email
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Object storage for ebook manuscripts (Vercel Blob). The download route
# fetches the file named by an ebook tier's `manuscriptFileKey` frontmatter
# field and streams it through our own token-gated /api/download/[token]
# route — the raw Blob URL is never exposed to the buyer.
BLOB_READ_WRITE_TOKEN=
