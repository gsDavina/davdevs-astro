# Postgres — transactional data only (orders, reaction counts, contact
# submissions). Editorial content is plain Markdown files in src/content/,
# not a database. Must point at a real Postgres server (port 5432 by
# default) — a local install, or a free Neon/Supabase project.
DATABASE_URL=

# Stripe — test-mode keys while developing (Dashboard → Developers → API keys)
STRIPE_SECRET_KEY=
# For local webhook testing, run `stripe listen --forward-to localhost:4321/api/webhooks/stripe`
# and use the signing secret it prints. In production this comes from a
# webhook endpoint registered in the Stripe Dashboard.
STRIPE_WEBHOOK_SECRET=

# Email (Gmail SMTP) — used for the contact form and ebook receipt/download
# emails. GMAIL_SMTP_USER is the full Gmail/Workspace address you're
# sending from; GMAIL_SMTP_APP_PASSWORD is a 16-character app password
# (Google Account → Security → App passwords), not your regular password —
# it requires 2-Step Verification to be enabled first. Port 465 uses
# implicit TLS; use 587 instead if you prefer STARTTLS.
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=465
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
GMAIL_FROM_EMAIL=

# Object storage for ebook manuscripts (S3 or Cloudflare R2). The download
# route generates a short-lived signed URL to the file named by an ebook's
# `manuscriptFileKey` frontmatter field — the bucket itself should not be
# public.
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
# Just the R2 account endpoint — no bucket name in the path (the bucket
# goes in OBJECT_STORAGE_BUCKET above; the client uses path-style requests).
# e.g. https://<account_id>.r2.cloudflarestorage.com
OBJECT_STORAGE_ENDPOINT=

# Error tracking (Sentry). DSNs aren't secret (they're meant to be embedded
# in client-side code), so this is PUBLIC_-prefixed on purpose — Astro/Vite
# only expose PUBLIC_-prefixed vars to browser code, and sentry.client.config.js
# needs this one there.
PUBLIC_SENTRY_DSN=
# Only needed at build time, to upload source maps
SENTRY_AUTH_TOKEN=