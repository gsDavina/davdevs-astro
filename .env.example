# Postgres — transactional data only (orders, reaction counts, contact
# submissions). Editorial content is plain Markdown files in src/content/,
# not a database. Must point at a real Postgres server (port 5432 by
# default) — a local install, or a free Neon/Supabase project.
DATABASE_URL=

# Stripe — test-mode keys while developing (Dashboard → Developers → API keys)
STRIPE_SECRET_KEY=
# For local webhook testing, run `stripe listen --forward-to localhost:4321/api/webhooks/stripe`
# and use the signing secret it prints. In production this comes from a
# webhook endpoint registered in the Stripe Dashboard.
STRIPE_WEBHOOK_SECRET=
# Client-side Stripe.js publishable key, from the same Dashboard → API
# keys page as the secret key above. Not currently read anywhere in
# src/ — kept here so it's on hand if client-side Stripe.js/Elements
# gets added later.
STRIPE_PUBLISHABLE_KEY=

# Resend — sends both the post-purchase ebook download-link email and the
# contact form's notification email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Where contact form submissions get sent.
CONTACT_TO_EMAIL=

# Cloudflare R2 (S3-compatible) — stores purchased ebook manuscripts. The
# download route fetches the object named by an ebook's `manuscriptFileKey`
# frontmatter field directly from this bucket — it should not be public.
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
# Just the R2 account endpoint — no bucket name in the path (the bucket
# goes in OBJECT_STORAGE_BUCKET above; the client uses path-style requests).
# e.g. https://<account_id>.r2.cloudflarestorage.com
OBJECT_STORAGE_ENDPOINT=

# Error tracking (Sentry). DSNs aren't secret (they're meant to be embedded
# in client-side code), so this is PUBLIC_-prefixed on purpose — Astro/Vite
# only expose PUBLIC_-prefixed vars to browser code, and both
# sentry.client.config.js and sentry.server.config.js read it via
# import.meta.env.PUBLIC_SENTRY_DSN.
PUBLIC_SENTRY_DSN=
# Only needed at build time, to create a release and upload source maps
# (see the sentry() integration in astro.config.mjs) -- a Sentry auth
# token with project:releases scope, from Settings -> Auth Tokens.
# Missing this just skips that step with a warning, it doesn't fail the
# build.
SENTRY_AUTH_TOKEN=